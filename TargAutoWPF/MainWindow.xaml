<Window x:Class="TargAutoWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aplicație Târg Auto" Height="800" Width="1300"
        Background="#0F172A" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="BadgeCheckBox" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="#1E293B" CornerRadius="15" Padding="12,5" Margin="0,0,8,8" BorderThickness="1" BorderBrush="#334155">
                            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <StackPanel x:Name="pnlMeniu" Margin="10,25">
                <Label Height="50"/>
                <Button Content="🤝 Tranzacții" Tag="0" Click="Menu_Click" Height="50" Background="#38BDF8" Foreground="White" BorderThickness="0" Margin="5,2" Cursor="Hand"/>
                <Button Content="👥 Clienți" Tag="1" Click="Menu_Click" Height="50" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Margin="5,2" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🚗" FontSize="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Aplicație Târg Auto" Foreground="White" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <TabControl x:Name="TabMain" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabItem>
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Margin="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="txtCauta" TextChanged="txtCauta_TextChanged" Margin="15" Height="35" 
                                         Tag="Căutare model..." Text="Căutare model..." Foreground="#94A3B8"
                                         GotFocus="RemoveGhostText" LostFocus="AddGhostText"/>

                                <DataGrid x:Name="dgTranzactii" Grid.Row="1" ItemsSource="{Binding TranzactiiOC}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="dgTranzactii_SelectionChanged" RowBackground="#1E293B" GridLinesVisibility="None">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Vânzător" Binding="{Binding Vanzator.Nume}" Width="*"/>
                                        <DataGridTextColumn Header="Cumpărător" Binding="{Binding Cumparator.Nume}" Width="*"/>
                                        <DataGridTextColumn Header="Model" Binding="{Binding Vehicul.Model}" Width="*"/>
                                        <DataGridTextColumn Header="Preț" Binding="{Binding Vehicul.Pret, StringFormat={}{0:C}}" Width="90"/>
                                        <DataGridTextColumn Header="Dotări" Binding="{Binding Vehicul.Optiuni}" Width="150">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="Margin" Value="0,5,0,5"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="#111827" CornerRadius="12" Margin="10" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Detalii Tranzacție" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                                    <TextBlock Text="VANZATOR / CUMPARATOR" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtVanzator" Tag="Nume Vânzător..." Text="Nume Vânzător..." Foreground="#94A3B8" Margin="0,0,0,5" GotFocus="RemoveGhostText" LostFocus="AddGhostText"/>
                                    <TextBox x:Name="txtCumparator" Tag="Nume Cumpărător..." Text="Nume Cumpărător..." Foreground="#94A3B8" GotFocus="RemoveGhostText" LostFocus="AddGhostText"/>

                                    <TextBlock Text="MODEL / PRET (€) [MVVM]" Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBox x:Name="txtModel" Tag="Model mașină..." Margin="0,0,0,5" GotFocus="RemoveGhostText" LostFocus="AddGhostText"
                                             Text="{Binding FormVM.ModelMasina, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"/>
                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <TextBox x:Name="txtPret" Tag="Preț (€)..." GotFocus="RemoveGhostText" LostFocus="AddGhostText"
                                             Text="{Binding FormVM.PretMasina, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"/>
                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <TextBlock Text="CULOARE (SELECTOR)" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="cmbCuloare" Height="32" Margin="0,0,0,10" Background="#1E293B" Foreground="Black">
                                        <ComboBoxItem Content="Alb" IsSelected="True"/>
                                        <ComboBoxItem Content="Negru"/>
                                        <ComboBoxItem Content="Rosu"/>
                                        <ComboBoxItem Content="Albastru"/>
                                        <ComboBoxItem Content="Gri"/>
                                        <ComboBoxItem Content="Verde"/>
                                    </ComboBox>

                                    <TextBlock Text="DOTARI (FLAGS)" Style="{StaticResource FieldLabelStyle}"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="chkAC" Content="Aer Condiționat" Style="{StaticResource BadgeCheckBox}"/>
                                        <CheckBox x:Name="chkNavi" Content="Navigație" Style="{StaticResource BadgeCheckBox}"/>
                                        <CheckBox x:Name="chkAuto" Content="Cutie Automată" Style="{StaticResource BadgeCheckBox}"/>
                                        <CheckBox x:Name="chkDecapotabila" Content="Decapotabilă" Style="{StaticResource BadgeCheckBox}"/>
                                        <CheckBox x:Name="chk4x4" Content="4x4" Style="{StaticResource BadgeCheckBox}"/>
                                        <CheckBox x:Name="chkGeamuri" Content="Geamuri Electrice" Style="{StaticResource BadgeCheckBox}"/>
                                    </WrapPanel>

                                    <TextBlock Text="DATA TRANZACTIE" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker x:Name="dpData" Margin="0,0,0,25"/>

                                    <Button Content="SALVEAZĂ" Click="btnAdauga_Click" Height="40" Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10"/>
                                    <UniformGrid Columns="2">
                                        <Button Content="Modifică" Click="btnModifica_Click" Background="#3B82F6" Foreground="White" Margin="0,0,5,0" Height="35"/>
                                        <Button Content="Șterge" Click="btnSterge_Click" Background="#EF4444" Foreground="White" Height="35" Margin="5,0,0,0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBox x:Name="txtNumeClient" Tag="Introduceți numele clientului..." Text="Introduceți numele clientului..." Foreground="#94A3B8" Width="350" Height="38" Margin="0,0,15,0" GotFocus="RemoveGhostText" LostFocus="AddGhostText"/>
                            <Button Content="Adaugă Client Nou" Click="btnAdaugaClient_Click" Width="180" Background="#38BDF8" Foreground="White" Height="38" FontWeight="Bold"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Bază de Date Clienți" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                    <DataGrid x:Name="dgClienti" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="White" RowBackground="#1E293B" GridLinesVisibility="None" SelectionChanged="dgClienti_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Numele Clientului" Binding="{Binding}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#111827" CornerRadius="12" Padding="15">
                                <StackPanel>
                                    <TextBlock x:Name="lblMasiniClient" Text="Selectează un client pentru a vedea mașinile" Foreground="#38BDF8" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                                    <DataGrid x:Name="dgMasiniClient" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="White" RowBackground="#111827" GridLinesVisibility="None">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Rol în Tranzacție" Binding="{Binding Rol}" Width="120" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Model Vehicul" Binding="{Binding ModelMasina}" Width="*"/>
                                            <DataGridTextColumn Header="Preț" Binding="{Binding Pret, StringFormat={}{0:C}}" Width="120"/>
                                            <DataGridTextColumn Header="Data Tranzacției" Binding="{Binding DataTranzactiei, StringFormat=dd/MM/yyyy}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>